<link rel="stylesheet" href="~/css/menu.css" />
@{
    ViewData["Title"] = "Index";
    var categories = ViewBag.Categories as List<Category>;
    var combos = ViewBag.Combos as List<Combo>;
}

<!-- Navigation Categories -->
<nav class="nav-menu">
    <div class="nav-content">
        @foreach (var category in categories)
        {
            <a href="#category-@category.Id" class="nav-item">@category.Name</a>
        }
        <a href="#combo" class="nav-item">Combo</a>
        <!-- Cart Button -->
        <div class="nav-item" id="cart-icon" onclick="toggleCart()">
            🛒 <span id="cart-count">0</span>
        </div>
    </div>
</nav>

<div class="promo-banner">
    <a href="#combo" class="nav-item">🍽️ Ăn no không lo về giá? Thử ngay những combo siêu rẻ!</a>
</div>
@foreach (var category in categories)
{
    <section id="category-@category.Id" class="category-section">
        <h2 class="section-title">@category.Name</h2>
        <div class="category-content">
            @if (category.Products != null && category.Products.Any())
            {
                <ul class="product-list">
                    @foreach (var product in category.Products)
                    {
                        <li class="product-item">
                            <img src="@product.ImageUrl" alt="@product.Name" class="product-image" />
                            <div class="product-info">
                                <div class="product-header">
                                    <span class="product-name">@product.Name</span>
                                    <span class="product-price">@product.Price.ToString("N0") đ</span>
                                </div>
                                <span class="product-descript">@product.Description</span>
                            </div>
                            <div class="product-actions">
                                <button class="btn btn-primary" onclick="addToCart('@product.Id', '@product.Name', @product.Price, '@product.Description','product')">Thêm</button>
                            </div>
                        </li>

                    }
                </ul>
            }
            else
            {
                <p class="no-products">No products available in this category.</p>
            }
        </div>
    </section>
}

<section id="combo" class="category-section">
    <h2 class="section-title">Combo</h2>
    <div class="category-content">
        <ul class="product-list">
            @foreach(var combo in combos)
            {
                @if (combo.Available != false)
                {
                        <li class="product-item">
                            <img src="@combo.ImageUrl" alt="@combo.Name" class="product-image" />
                            <div class="product-info">
                                <div class="product-header">
                                    <span class="product-name">@combo.Name</span>
                                    <span class="product-price">@combo.Price.ToString("N0") đ</span>
                                </div>
                                <span class="product-descript">@combo.Description</span>
                            </div>
                            <div class="product-actions">
                            <button class="btn btn-primary" onclick="addToCart('@combo.Id', '@combo.Name', @combo.Price, '@combo.Description','combo')">Thêm</button>
                            </div>
                        </li>
                }
                else
                {
                    <p> class="no-products">No Combo available.</p>
                }
            }
        </ul>
    </div>
</section>

<div id="cart-modal" class="cart-modal">
    <div class="cart-content">
        <div class="cart-header">
            <h3>Giỏ hàng của bạn</h3>
            <button class="close-cart" onclick="toggleCart()">&times;</button>
        </div>
        <div id="cart-items">
            <div class="empty-cart">
                <p>Giỏ hàng trống</p>
            </div>
        </div>
        <div id="cart-total" class="cart-total" style="display: none;">
            Tổng cộng: <span id="total-amount">0</span> đ
            <br><br>
            <button class="btn btn-success" onclick="showCustomerForm()">Đặt Món</button>
        </div>
    </div>
</div>
<!-- Customer Info Modal -->
<div id="customer-modal" class="customer-modal">
    <div class="customer-content">
        <div class="customer-header">
            <h3>Thông tin đặt món</h3>
        </div>

        <!-- Order Summary -->
        <div class="order-summary">
            <h4>Chi tiết đơn hàng</h4>
            <div id="order-summary-items"></div>
            <div class="order-total">
                Tổng cộng: <span id="order-total-amount">0</span> đ
            </div>
        </div>

        <!-- Customer Form -->
        <form id="customer-form">
            <div class="form-group">
                <label for="customer-name">Họ và tên <span class="required">*</span></label>
                <input type="text" id="customer-name" name="name" class="form-control" required>
                <div class="error-message" id="name-error"></div>
            </div>

            <div class="form-group">
                <label for="customer-phone">Số điện thoại <span class="required">*</span></label>
                <input type="tel" id="customer-phone" name="phone" class="form-control" required pattern="[0-9]{10,11}">
                <div class="error-message" id="phone-error"></div>
            </div>

            <div class="form-group">
                <label for="customer-email">Email</label>
                <input type="email" id="customer-email" name="email" class="form-control">
                <div class="error-message" id="email-error"></div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-cancel" onclick="closeCustomerForm()">Hủy</button>
                <button type="submit" class="btn btn-success">Xác nhận đặt món</button>
            </div>
        </form>

        <!-- Loading State -->
        <div class="loading" id="loading">
            <p>Đang xử lý đơn hàng...</p>
        </div>

        <!-- Success State -->
        <div class="success-message" id="success-message">
            <h4>✅ Đặt món thành công!</h4>
            <p>Mã đơn hàng: <strong id="order-code"></strong></p>
            <p>Cảm ơn bạn đã đặt hàng! Chúng tôi sẽ chuẩn bị và chuyển đồ ăn đến với bạn sớm nhất có thể.</p>
            <button class="btn btn-primary" onclick="closeCustomerForm(); clearCart();">Đóng</button>
        </div>
    </div>
</div>
<script src="~/js/Cart.js"></script>
<script src="~/js/Menu.js"></script>

